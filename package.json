{
  "name": "@yamakox/vue3-plotly",
  "version": "0.4.0",
  "type": "module",
  "description": "A Vue 3 wrapper component for Plotly.js",
  "author": "yamakox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamakox/vue3-plotly.git"
  },
  "keywords": [
    "vue",
    "plotly",
    "chart",
    "graph",
    "visualization"
  ],
  "homepage": "https://github.com/yamakox/vue3-plotly",
  "bugs": {
    "url": "https://github.com/yamakox/vue3-plotly/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "rimraf dist && npm run build",
    "build": "vite build && npm run build:types",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "plotly.js-dist-min": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
